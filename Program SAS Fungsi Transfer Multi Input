/* =========================
ARIMA & TRANSFER FUNCTION
========================= */

proc arima data = dataset_saya ;

/* identifikasi arima deret Money Stock */
identify var =X1 (1) ;

/* estimasi parameter model ARIMA X1 */
estimate p=3 q=2 method =ml;
run ;

/* identifikasi arima deret input Indeks S&P 500 */
identify var =X2 (1) ;

/* estimasi parameter model ARIMA X2 */
estimate p =(7 ,14) q=0 method =ml;
run ;

/* Fungsi Transfer Multi Input : CCF */
identify var =Y (1) crosscorr =( X1 (1) X2 (1)) nlag =40;
run ;

/* estimasi parameter awal fungsi transfer */
estimate p =(5) q=0
input =(25 $(1 ,2) /(0) X1 7$ (0) /(0) X2)
printall plot method =ml;

/* Peramalan Fungsi Transfer */
forecast out = ramalan lead =18 printall ;
run ;

/* cek normalitas residual */
proc univariate data = ramalan normal ;
var residual ;
run ;
